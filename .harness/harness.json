{
  "kind": "code",
  "oracle": "node tools/elt-oracle-runner.js",
  "smoke": "node tools/smoke-elt-deploy.js",
  "shell": "powershell",
  "branchPolicy": "feature",
  "push": false,
  "judge": {
    "enabled": true,
    "provider": "claude",
    "model": "sonnet",
    "attest": true
  },
  "redProof": "on",
  "oracleSelect": "impact",
  "verify": "background",
  "testCmd": "node",
  "redProofTimeoutMs": 120000,
  "batch": 3,
  "codegraphGuard": true,
  "specApproval": true,
  "background": {
    "layers": [
      "suite",
      "mutate",
      "smoke",
      "judge"
    ]
  }
}

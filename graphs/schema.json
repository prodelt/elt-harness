{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elt-graph/v1",
  "title": "ELT v5 graph document",
  "type": "object",
  "required": ["graphVersion", "schemas", "entry", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "graphVersion": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" }
    },
    "entry": { "type": "string" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$" },
    "predicate": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "node": {
      "type": "object",
      "required": ["id", "kind", "consumes", "produces", "guards", "sideEffects", "trust", "platforms", "timeoutMs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "enum": ["source", "action", "decision", "gate", "barrier", "sink"] },
        "consumes": { "type": "array", "items": { "type": "string" } },
        "produces": { "type": "array", "items": { "type": "string" } },
        "guards": { "type": "array", "items": { "$ref": "#/$defs/predicate" } },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/predicate" } },
        "sideEffects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["workspace", "git", "network", "secrets", "none"] }
        },
        "trust": { "type": "string", "enum": ["core", "reviewed", "unreviewed"] },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["win32", "linux", "darwin"] }
        },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "failure": { "type": "string", "enum": ["block", "degrade", "skip"] }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "event"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "event": { "$ref": "#/$defs/predicate" },
        "guards": { "type": "array", "items": { "$ref": "#/$defs/predicate" } },
        "loop": { "type": "boolean" },
        "repair": { "type": "boolean" }
      }
    }
  }
}

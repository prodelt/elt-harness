{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "88",
    "MAX_THINKING_TOKENS": "30000",
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "25000",
    "ENABLE_TOOL_SEARCH": "auto:10"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Agent",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__skillsmp__skillsmp_ai_search",
      "mcp__skillsmp__skillsmp_search",
      "mcp__skillsmp__skillsmp_get_skill_content",
      "mcp__skillsmp__skillsmp_list_repo_skills",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__list_pages",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_screenshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_snapshot",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_tabs",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(node --version)",
      "Bash(node --version *)",
      "Bash(npm list *)",
      "Bash(npm list)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx tsc --noEmit)",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__new_page",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__evaluate_script",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__close_page",
      "Read(//c/Claude playground/Ametrin website 2/**)",
      "Bash(npx create-next-app@latest . --typescript --tailwind --eslint --app --src-dir --import-alias \"@/*\" --use-npm --yes)",
      "Bash(npm install:*)",
      "Bash(npx next:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/context-budget-gate.js\"",
            "statusMessage": "Checking context budget..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/project-docs-gate.js\"",
            "statusMessage": "Checking project docs..."
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/session-focus-gate.js\"",
            "statusMessage": "Session focus check..."
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/autoskills-check.js\"",
            "statusMessage": "Detecting tech stack..."
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/graphify-session-init.js\"",
            "statusMessage": "Checking Graphify graph..."
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/memory-discipline.js\"",
            "statusMessage": "Checking memory size..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/graphify-read-gate.js\""
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/graphify-preuse.js\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/config-protection.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/domain-agent-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/edit-enforcer.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/secret-scanner.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/quality-gate-runner.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/verification-tracker.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/loop-guardian.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/secret-output-scanner.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/post-edit-combined.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/context7-reminder.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/inline-review-gate.js\""
          }
        ]
      },
      {
        "matcher": "mcp__context7__resolve-library-id|mcp__context7__query-docs|mcp__plugin_context7_context7__resolve-library-id|mcp__plugin_context7_context7__query-docs",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/context7-tracker.js\""
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/scope-guard.js\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/inline-review-tracker.js\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/pipeline-tracker.js\""
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "\\.env|\\.envrc",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/env-change-watcher.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/stop-verification.js\"",
            "statusMessage": "Running session-end verification..."
          },
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/ship-gate.js\"",
            "statusMessage": "Checking uncommitted changes..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "TaskCompleted",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/user/.claude/hooks/task-completed-gate.js\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "supabase@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "ralph-wiggum@claude-code-plugins": false,
    "context7@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "language": "Russian",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}

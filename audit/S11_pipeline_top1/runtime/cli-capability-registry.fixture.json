{
  "scenarios": [
    {
      "name": "github-discovery",
      "tool": "gh",
      "transport": "cli",
      "commandName": "search-repos",
      "params": {
        "query": "lightrag graph rag",
        "limit": "5"
      }
    },
    {
      "name": "docs-site-crawl",
      "tool": "firecrawl",
      "transport": "cli",
      "commandName": "crawl",
      "params": {
        "url": "https://docs.example.com",
        "limit": "50",
        "depth": "2",
        "output": "docs.json"
      }
    },
    {
      "name": "deployment-log-check",
      "tool": "vercel",
      "transport": "cli",
      "commandName": "logs",
      "params": {
        "deployment": "my-app-production"
      }
    }
  ],
  "mcpPreferenceChecks": [
    {
      "tool": "context7",
      "need": "official API docs",
      "expectedTransport": "mcp"
    },
    {
      "tool": "playwright",
      "need": "interactive browser control in agent session",
      "expectedTransport": "mcp"
    },
    {
      "tool": "gh",
      "need": "repository discovery",
      "expectedTransport": "cli"
    }
  ]
}
